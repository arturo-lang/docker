# syntax=docker/dockerfile:1
FROM ubuntu:24.04 AS downloader
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl unzip
RUN curl -fsSL https://get.arturo-lang.io -o /tmp/install-arturo.sh && \
    sh /tmp/install-arturo.sh && \
    test -x /root/.arturo/bin/arturo

# Match the existing full image's library versions. No download tools enter this
# stage; WebKit resolves its own GTK dependencies without a separate GTK install.
FROM ubuntu:24.04 AS runtime-dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates libpcre2-8-0 libssl3t64 libstdc++6 libgmp10 libmpfr6 libwebkit2gtk-4.1-0
COPY --from=downloader /root/.arturo/bin/ /opt/arturo/
COPY scripts/collect-runtime.sh /tmp/collect-runtime.sh
RUN sh /tmp/collect-runtime.sh full

FROM scratch
COPY --from=runtime-dependencies /runtime/ /
ENV HOME=/root
WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/arturo"]
