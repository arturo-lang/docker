FROM alpine:latest

RUN apk add --no-cache \
    curl \
    ca-certificates \
    bash \
    unzip \
    jq \
    gcompat \
    pcre2

COPY scripts/install-nightly.sh /tmp/install-nightly.sh
RUN sh /tmp/install-nightly.sh mini

ENV PATH="/root/.arturo/bin:${PATH}"

WORKDIR /workspace
ENTRYPOINT ["arturo"]